# Copy to .env and adjust as needed. Flask does not auto-load .env files
# without python-dotenv; either `pip install python-dotenv` and load it
# at the top of app.py, or export these in your shell / container env.

# Flask
SECRET_KEY=change-me-to-a-random-value
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=20
UPLOAD_RETENTION_HOURS=24

# Model
MODEL_DIR=models/bert_model
MAX_TOKEN_LENGTH=256

# Evaluation artifacts
EVALUATION_DIR=evaluation
